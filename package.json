{
  "name": "ai-relay-gateway",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-provider, multi-key AI relay gateway with automatic key rotation and provider failover. Runs free on Cloudflare Workers.",
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && wrangler dev",
    "dev:ui": "vite",
    "build:ui": "vite build",
    "build": "npm run build:ui",
    "deploy": "npm run build:ui && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "setup": "node scripts/setup.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types"
  },
  "cloudflare": {
    "bindings": {
      "ADMIN_PASSWORD": {
        "description": "Password for the gateway admin dashboard."
      },
      "ENCRYPTION_KEY": {
        "description": "Secret used to encrypt upstream API keys at rest (any long random string, e.g. `openssl rand -base64 32`)."
      },
      "SESSION_SECRET": {
        "description": "Secret used to sign dashboard session cookies (any long random string)."
      }
    }
  },
  "dependencies": {
    "@tanstack/react-query": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hono": "^4.13.18",
    "lucide-react": "1.73.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261112.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.28.2": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261110.1": true
  }
}
